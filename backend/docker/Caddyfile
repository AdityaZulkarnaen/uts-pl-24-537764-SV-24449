{
	frankenphp
	admin off

	# Kumpulkan metrik HTTP Caddy (jumlah request, durasi, kode status)
	metrics
}

:8000 {
	root * /app/public
	encode zstd br gzip

	# Access log dimatikan agar tidak mencatat data pribadi atau header sensitif
	log {
		output discard
	}

	php_server
}

# Endpoint metrik untuk Prometheus. Port ini tidak dipublikasikan ke host,
# hanya bisa diakses dari jaringan internal compose.
:2019 {
	metrics /metrics
}
