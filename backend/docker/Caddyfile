{
	frankenphp
	admin off
}

:8000 {
	root * /app/public
	encode zstd br gzip

	# Access log on stdout, so `docker compose logs backend` shows every
	# request handled by FrankenPHP. Health checks are left out as noise.
	log {
		output stdout
		format console
	}

	@health path /up
	log_skip @health

	php_server
}
