              "host": [
                "{{base_url}}"
              ],
              "path": [
                "items",
                "{{item_id}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Show Item Terhapus (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
