      ]
    },
    {
      "name": "Logout",
      "item": [
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set(\"token\", \"\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
