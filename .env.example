# Salin menjadi .env lalu isi nilainya. File .env tidak ikut di-commit.

# Laravel application key: jalankan `php artisan key:generate --show` di folder backend
APP_KEY=

# Kredensial basis data MySQL (dipakai service db dan backend)
DB_DATABASE=inventaris_lab
DB_USERNAME=inventaris
DB_PASSWORD=ganti-dengan-password-kuat
DB_ROOT_PASSWORD=ganti-dengan-password-root-kuat

# Akun demo yang dibuat seeder
DEMO_USER_EMAIL=admin@lab.test
DEMO_USER_PASSWORD=password

# Port di laptop (ubah jika bentrok dengan aplikasi lain)
BACKEND_PORT=8000
FRONTEND_PORT=8080
